# BLACKBOX local configuration. Copy to .env (`make env`) and adjust.
# .env is git-ignored. Never put real secrets in this example file.
# Keep comments on their own lines: inline comments are parsed inconsistently by make/compose.
#
# Phase 1 (foundation) needs no secrets. Later phases will add Switch agent keys,
# a model API key and webhook secrets here; each will be documented when it is introduced.

# ---- Backend ---------------------------------------------------------------
# development | test | production
BLACKBOX_ENV=development
# DEBUG | INFO | WARNING | ERROR
BLACKBOX_LOG_LEVEL=INFO
# json | console
BLACKBOX_LOG_FORMAT=console
# Run Alembic migrations automatically at API startup.
BLACKBOX_AUTO_MIGRATE=true
# Default: backend/data/blackbox.db (local) or /data/blackbox.db (Docker volume).
# BLACKBOX_DATABASE_URL=sqlite:////absolute/path/to/blackbox.db
BLACKBOX_CORS_ORIGINS='["http://localhost:5180","http://127.0.0.1:5180"]'

# ---- Host ports -------------------------------------------------------------
# 8000 and 5173 are commonly taken on dev machines; these defaults avoid them.
# FastAPI (local dev and Docker)
BLACKBOX_BACKEND_PORT=8010
# Vite dev server
BLACKBOX_FRONTEND_PORT=5180
# nginx-served frontend in Docker
BLACKBOX_WEB_PORT=8088

# ---- Frontend --------------------------------------------------------------
# Where the Vite dev server proxies /api to.
BLACKBOX_BACKEND_URL=http://localhost:8010
# Leave empty to call the API same-origin under /api (recommended).
VITE_API_BASE_URL=

# ---- Switch integration (Task 10 proof) -------------------------------------
# Agent bridge base URL of your Switch server (switch-core), not the Gateway UI.
SWITCH_API_URL=http://127.0.0.1:8100
# Used once to mint a personal registration key, so the agents are owned by the
# incident commander (required for them to answer approval cards). Alternatively
# set SWITCH_REGISTRATION_KEY to a key minted in the Gateway.
SWITCH_GATEWAY_ADMIN_EMAIL=
SWITCH_GATEWAY_ADMIN_PASSWORD=
# SWITCH_REGISTRATION_KEY=
# The incident commander's username on the bridged chat platform.
SWITCH_IC_CHAT_USERNAME=user
# TEST HARNESS ONLY (make switch-proof-auto): the IC's Mattermost password, used to
# act as that person through Mattermost's own API. Never used by product code.
MATTERMOST_URL=http://127.0.0.1:8065
MATTERMOST_IC_PASSWORD=

# ---- Simulator ----
# Bearer token for the sandbox launcher (only the executor and sim control hold it).
SIM_LAUNCHER_TOKEN=
# HMAC secret shared by the monitor and the backend webhook.
BLACKBOX_WEBHOOK_SECRET=
# Open-loop load (requests/second) and the time each payment holds a DB connection.
SIM_LOAD_RPS=120
SIM_SCORING_SECONDS=0.1

# ---- Slack (human-facing notifications; docs/11-SLACK-INTEGRATION.md) -------
# Slack is notification-only: agents collaborate in Switch, approvals happen only on the
# Switch card. Leave everything empty to run without Slack.
# Encrypts Slack bot tokens at rest (Fernet key). Generate with: make slack-key
BLACKBOX_SECRET_KEY=
# Protects /api/slack/admin/* (set channel, import token, test, disconnect).
BLACKBOX_ADMIN_TOKEN=
# Base URL used in "View in BLACKBOX" links posted to Slack.
BLACKBOX_PUBLIC_URL=http://localhost:5180
# From the Slack app's "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must exactly match a Redirect URL in the Slack app (public HTTPS, e.g. a tunnel):
# https://<your-tunnel>/api/slack/oauth/callback
SLACK_REDIRECT_URI=
# Comma-separated workspace ids (T...) allowed to install and use the app. Strongly recommended.
SLACK_ALLOWED_TEAM_IDS=
# Default incident channel id (C...). Can also be set with POST /api/slack/admin/channel.
SLACK_INCIDENT_CHANNEL_ID=
# Channels where /blackbox works. Empty = only the incident channel.
SLACK_COMMAND_CHANNEL_IDS=
# Run the event bridge inside the API (true) or as `make slack-bridge` (false).
SLACK_BRIDGE_IN_API=true
SLACK_BRIDGE_POLL_SECONDS=2
# Genuine integration test only (make slack-live-test):
# SLACK_LIVE_TEST=1
# SLACK_LIVE_BOT_TOKEN=xoxb-...
# SLACK_LIVE_CHANNEL_ID=C...
